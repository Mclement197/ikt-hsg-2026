        <object id="p3_extract" label="Extract billing-period&#10;records" description="Select the April–March billing year and a UTC cutoff. Intersect registered ownerships with the tax year, including every non-empty segment that has started by the cutoff. Keep the vehicle type and the stored billing-year label even if the case is missing." role="Reporting analyst" system="SQLite / reporting workspace" inputs="Billing year and cutoff&#10;Ownership periods, vehicles and vehicle types&#10;Tax cases, declarations, assessments and odometer readings" outputs="Reporting dataset with population and period boundaries" added="false" kind="function" model_id="p3_extract" phase="Prepare and validate source data" original_label="Extract billing-period records" tooltip="Extract billing-period records&#10;&#10;Select the April–March billing year and a UTC cutoff. Intersect registered ownerships with the tax year, including every non-empty segment that has started by the cutoff. Keep the vehicle type and the stored billing-year label even if the case is missing.&#10;&#10;Role: Reporting analyst&#10;&#10;Application: SQLite / reporting workspace&#10;&#10;Inputs: Billing year and cutoff; Ownership periods, vehicles and vehicle types; Tax cases, declarations, assessments and odometer readings&#10;&#10;Outputs: Reporting dataset with population and period boundaries">
          <mxCell vertex="1" parent="flow" style="html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#243d4a;align=center;verticalAlign=middle;spacing=2;fillColor=#edf7ee;strokeColor=#347b42;strokeWidth=1.3;shadow=0;shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=16;perimeter=rectanglePerimeter;">
            <mxGeometry x="1619.66" y="407.68" width="209" height="52" as="geometry" />
          </mxCell>
        </object>
        <object id="p3_available" label="Reporting dataset available" description="The input records and their coverage are available for validation." added="false" kind="event" model_id="p3_available" phase="Prepare and validate source data" original_label="Reporting dataset available" tooltip="Reporting dataset available&#10;&#10;The input records and their coverage are available for validation.">
