        <object id="p3_withheld" label="Report withheld; correction&#10;requested" description="The existing blocked outcome is now a waiting state that leads to source correction and fresh extraction, whether the defect was found during initial validation or report review. No report is released from the rejected snapshot." added="false" kind="event" model_id="p3_withheld" phase="Prepare and validate source data" original_label="Report withheld; correction requested" tooltip="Report withheld; correction requested&#10;&#10;The existing blocked outcome is now a waiting state that leads to source correction and fresh extraction, whether the defect was found during initial validation or report review. No report is released from the rejected snapshot.">
          <mxCell vertex="1" parent="flow" style="html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#243d4a;align=center;verticalAlign=middle;spacing=2;fillColor=#fcedf5;strokeColor=#b72c7d;strokeWidth=1.3;shadow=0;shape=hexagon;perimeter=hexagonPerimeter;size=0.25;">
