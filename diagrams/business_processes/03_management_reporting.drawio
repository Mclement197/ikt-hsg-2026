        <object id="p3_adjustment_query" label="Aggregate gross assessed&#10;adjustments" description="Group current issued assessments by the stored billing-year label. Compare each final tax with the original advance due (the first accepted demand, even if later superseded). Count additions and refunds and sum them separately in GBP; disclose missing original advances." role="Reporting analyst" system="SQLite / additional_tax.sql" inputs="Issued assessments and their billing years&#10;Original advance due per assessed case" outputs="Assessed cases&#10;Additional-payment and refund case counts&#10;Gross additions and refunds in GBP&#10;Cases missing an original advance" added="false" kind="function" model_id="p3_adjustment_query" phase="Run both analyses" original_label="Aggregate gross assessed adjustments" tooltip="Aggregate gross assessed adjustments&#10;&#10;Group current issued assessments by the stored billing-year label. Compare each final tax with the original advance due (the first accepted demand, even if later superseded). Count additions and refunds and sum them separately in GBP; disclose missing original advances.&#10;&#10;Role: Reporting analyst&#10;&#10;Application: SQLite / additional_tax.sql&#10;&#10;Inputs: Issued assessments and their billing years; Original advance due per assessed case&#10;&#10;Outputs: Assessed cases; Additional-payment and refund case counts; Gross additions and refunds in GBP; Cases missing an original advance">
          <mxCell vertex="1" parent="flow" style="html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#243d4a;align=center;verticalAlign=middle;spacing=2;fillColor=#edf7ee;strokeColor=#347b42;strokeWidth=1.3;shadow=0;shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=16;perimeter=rectanglePerimeter;">
