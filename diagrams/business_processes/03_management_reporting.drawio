          </mxCell>
        </object>
        <object id="p3_advance_ready" label="Forecast and&#10;coverage results&#10;available" description="Each year/type row retains its distinct vehicle count and incomplete-segment count. When a segment is incomplete, group miles and expected final tax are NULL and the grand total is withheld; other complete groups remain reportable." added="true" kind="event" model_id="p3_advance_ready" phase="Run both analyses" original_label="Forecast and coverage results available" tooltip="Forecast and coverage results available&#10;&#10;Each year/type row retains its distinct vehicle count and incomplete-segment count. When a segment is incomplete, group miles and expected final tax are NULL and the grand total is withheld; other complete groups remain reportable.">
