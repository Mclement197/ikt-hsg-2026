        <object id="p3_check" label="Check forecast coverage&#10;and data quality" description="Check every expected segment for a case and usable evidence at the cutoff. An issued assessment covers the segment; an exact accepted estimate suffices only while it is open. Zero is valid. A missing case or unusable source is a coverage exception: take the issues branch, correct the source, extract again and revalidate." role="Controlling" system="SQLite / validation worksheet" inputs="Registered ownership/year segments&#10;Cases and evidence at the cutoff&#10;Mileage, tax and coverage rules" outputs="Data-quality result and coverage statement" added="false" kind="function" model_id="p3_check" phase="Prepare and validate source data" original_label="Check forecast coverage and data quality" tooltip="Check forecast coverage and data quality&#10;&#10;Check every expected segment for a case and usable evidence at the cutoff. An issued assessment covers the segment; an exact accepted estimate suffices only while it is open. Zero is valid. A missing case or unusable source is a coverage exception: take the issues branch, correct the source, extract again and revalidate.&#10;&#10;Role: Controlling&#10;&#10;Application: SQLite / validation worksheet&#10;&#10;Inputs: Registered ownership/year segments; Cases and evidence at the cutoff; Mileage, tax and coverage rules&#10;&#10;Outputs: Data-quality result and coverage statement">
          <mxCell vertex="1" parent="flow" style="html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#243d4a;align=center;verticalAlign=middle;spacing=2;fillColor=#edf7ee;strokeColor=#347b42;strokeWidth=1.3;shadow=0;shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=16;perimeter=rectanglePerimeter;">
            <mxGeometry x="1612.66" y="597.2" width="223" height="52" as="geometry" />
          </mxCell>
        </object>
        <object id="p3_quality_split" label="XOR" description="Exactly one outcome follows the data-quality check: accepted data or issues requiring correction." added="false" kind="xor" model_id="p3_quality_split" phase="Prepare and validate source data" original_label="XOR" tooltip="XOR&#10;&#10;Exactly one outcome follows the data-quality check: accepted data or issues requiring correction.">
