        <object id="p3_advance_query" label="Aggregate expected advance&#10;liability" description="Make the first existing analysis explicit. expected_revenue.sql joins declarations to vehicles and groups by period_start year and vehicle_type. It returns distinct vehicles, declared miles, and advance_due_pence totals converted to GBP. These are assessed advance liabilities, not received cash." role="Reporting analyst" system="SQLite / expected_revenue.sql" inputs="Accepted declarations&#10;Vehicle types" outputs="Distinct vehicles by type and period-start year&#10;Total declared miles&#10;Expected advance liability in GBP" added="false" kind="function" model_id="p3_advance_query" phase="Run both analyses" original_label="Aggregate expected advance liability" tooltip="Aggregate expected advance liability&#10;&#10;Make the first existing analysis explicit. expected_revenue.sql joins declarations to vehicles and groups by period_start year and vehicle_type. It returns distinct vehicles, declared miles, and advance_due_pence totals converted to GBP. These are assessed advance liabilities, not received cash.&#10;&#10;Role: Reporting analyst&#10;&#10;Application: SQLite / expected_revenue.sql&#10;&#10;Inputs: Accepted declarations; Vehicle types&#10;&#10;Outputs: Distinct vehicles by type and period-start year; Total declared miles; Expected advance liability in GBP">
          <mxCell vertex="1" parent="flow" style="html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#243d4a;align=center;verticalAlign=middle;spacing=2;fillColor=#edf7ee;strokeColor=#347b42;strokeWidth=1.3;shadow=0;shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=16;perimeter=rectanglePerimeter;">
