        <object id="editing-5" label="• This file contains the complete revised proposal from Revision 2 of the HTML. It does not change the repository." kind="annotation">
          <mxCell vertex="1" parent="notes" style="shape=text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#243d4a;align=left;verticalAlign=middle;spacing=0;">
