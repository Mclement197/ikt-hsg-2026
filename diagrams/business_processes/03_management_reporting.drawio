        <object id="p3_adjustment_query" label="Aggregate gross assessed&#10;adjustments" description="Make the second existing analysis explicit. additional_tax.sql joins declarations to tax_assessments and groups by period_start year. It compares final_tax_pence with advance_due_pence to count top-up/refund cases and total gross additional tax/refunds. It does not calculate cash receivables or payments already made." role="Reporting analyst" system="SQLite / additional_tax.sql" inputs="Accepted declarations&#10;Final tax assessments" outputs="Assessed declaration counts&#10;Additional-payment and refund case counts&#10;Gross additional tax and gross refunds in GBP" added="false" kind="function" model_id="p3_adjustment_query" phase="Run both analyses" original_label="Aggregate gross assessed adjustments" tooltip="Aggregate gross assessed adjustments&#10;&#10;Make the second existing analysis explicit. additional_tax.sql joins declarations to tax_assessments and groups by period_start year. It compares final_tax_pence with advance_due_pence to count top-up/refund cases and total gross additional tax/refunds. It does not calculate cash receivables or payments already made.&#10;&#10;Role: Reporting analyst&#10;&#10;Application: SQLite / additional_tax.sql&#10;&#10;Inputs: Accepted declarations; Final tax assessments&#10;&#10;Outputs: Assessed declaration counts; Additional-payment and refund case counts; Gross additional tax and gross refunds in GBP">
          <mxCell vertex="1" parent="flow" style="html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#243d4a;align=center;verticalAlign=middle;spacing=2;fillColor=#edf7ee;strokeColor=#347b42;strokeWidth=1.3;shadow=0;shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=16;perimeter=rectanglePerimeter;">
