        </mxCell>
        <mxCell id="subtitle" value="Proposed logical model • six entities • crow’s foot cardinalities • all shapes and connectors are editable" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#52677C;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
