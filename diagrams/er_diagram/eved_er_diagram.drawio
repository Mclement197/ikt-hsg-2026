        <mxCell id="title" value="eVED | Entity–Relationship Diagram" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=32;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
