        <mxCell id="legendtitle" value="HOW TO READ THE MODEL" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
