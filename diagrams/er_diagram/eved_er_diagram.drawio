        </mxCell>
        <mxCell id="legend1" value="Exactly one" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
