        </mxCell>
        <mxCell id="legend3" value="Zero or many" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="135" y="644" width="140" height="25" />
        </mxCell>
        <mxCell id="integritytitle" value="INTEGRITY RULES" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="82" y="1173" width="476" height="32" />
        </mxCell>
        <mxCell id="integritybody" value="• Both readings belong to the declared vehicle.&#10;• Reading dates match the period boundaries.&#10;• Closing miles ≥ opening miles.&#10;• Each reading is used at most once per role.&#10;• All shown fields are required (NOT NULL)." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="82" y="1221" width="476" height="126" />
        </mxCell>
        <mxCell id="moneytitle" value="PAYMENTS AND BALANCES" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="632" y="1173" width="506" height="32" />
        </mxCell>
        <mxCell id="moneybody" value="• Advances can exist before a final assessment.&#10;• Additional payments / refunds need an assessment.&#10;• amount_pence &gt; 0; REFUND is an outflow.&#10;• Open balance = final tax − net cash received.&#10;• Net cash = advances + extras − refunds." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="632" y="1221" width="506" height="126" />
        </mxCell>
        <mxCell id="designtitle" value="DESIGN CHOICES" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1212" y="1173" width="446" height="32" />
        </mxCell>
        <mxCell id="designbody" value="• BEV: 3p/mile; PHEV: 1.5p/mile.&#10;• Integer pence; round half-pennies upwards.&#10;• Actual miles and balances are calculated.&#10;• Rates and ownership stay fixed in the prototype.&#10;• No live DVLA or MOT integrations are assumed." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1212" y="1221" width="446" height="126" />
        </mxCell>
        <mxCell id="footer" value="Draft for Case A. Based on the README, the three process diagrams and IKT VL03. Compare this proposed model with schema.sql before implementation." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#52677C;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
