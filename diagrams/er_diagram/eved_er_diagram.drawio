          <mxGeometry as="geometry" x="82" y="546" width="376" height="111" />
        </mxCell>
        <mxCell id="keys" value="PK = primary key    FK = foreign key&#10;UQ = unique value / combination" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
