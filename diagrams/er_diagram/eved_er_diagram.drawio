        </mxCell>
        <mxCell id="legend2" value="Zero or one" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#17324D;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
