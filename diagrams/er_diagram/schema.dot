odometer_readings:supersedes_reading_id_from:e -> odometer_readings:reading_id_to:w
odometer_readings:mot_centre_id_from:e -> mot_centres:mot_centre_id_to:w
odometer_readings:vehicle_id_from:e -> vehicles:vehicle_id_to:w
declarations:supersedes_declaration_id_from:e -> declarations:declaration_id_to:w
