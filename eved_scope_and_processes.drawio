        </mxCell>
        <mxCell id="rulesbody" value="Actual miles = closing − opening.&#10;Check vehicle, boundary dates and&#10;non-decreasing odometer miles.&#10;&#10;Final tax = actual miles × rate;&#10;round once, half-pennies upwards.&#10;&#10;At settlement, subtract the advance&#10;received. Positive: invoice;&#10;negative: refund; zero: balanced." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#17324D;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;text;spacing=0;" vertex="1" parent="1">
