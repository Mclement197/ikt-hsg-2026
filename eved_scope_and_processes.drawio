        <mxCell id="examplebody" value="Alice: 20,000 → 26,000 miles&#10;£300 paid; £180 assessed&#10;£120 refunded after transfer&#10;&#10;Ben: 26,000 → 32,000 miles&#10;£150 paid; £180 assessed&#10;£30 extra received&#10;&#10;Same reading on 1 January.&#10;See transfer detail page." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#17324D;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;text;spacing=0;" vertex="1" parent="1">
