        <mxCell id="excludedtitle" value="OUTSIDE THE PROTOTYPE" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=19;fontColor=#17324D;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;fontStyle=1;text;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="752" y="993" width="586" height="36" />
        </mxCell>
        <mxCell id="excludedbody" value="• Live APIs, public portal and authentication.&#10;• GPS or journey tracking; production deployment.&#10;• Owner changes, new vehicles and odometer resets.&#10;• Appeals, penalties, fraud and debt collection.&#10;• Privacy and scaling are analysed conceptually." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#17324D;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;text;spacing=0;" vertex="1" parent="1">
