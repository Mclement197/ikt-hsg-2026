          <mxGeometry as="geometry" x="82" y="193" width="306" height="36" />
        </mxCell>
        <mxCell id="rulesbody" value="Actual miles = closing reading&#10;minus opening reading.&#10;&#10;Final tax = actual miles × rate.&#10;Round tax to the nearest penny.&#10;&#10;Balance = final tax minus&#10;advance payments received.&#10;&#10;Positive: extra payment due&#10;Negative: refund due&#10;Zero: no adjustment" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#17324D;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;text;spacing=0;" vertex="1" parent="1">
