        </mxCell>
        <mxCell id="assumptionsbody" value="• One billing year: 1 Apr 2028 to 31 Mar 2029.&#10;• One unchanged owner per vehicle during the year.&#10;• Valid readings at both period boundaries.&#10;• Miles; fixed BEV / PHEV rates; fictional records.&#10;• DVLA and payment interfaces are simulated." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#17324D;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;text;spacing=0;" vertex="1" parent="1">
